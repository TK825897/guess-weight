{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist-server",
    "rootDir": "./server",
    "strict": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["server"]
}
